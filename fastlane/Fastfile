default_platform(:ios)

platform :ios do
  lane :beta do
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    key_path = File.expand_path("~/private_keys/AuthKey_#{key_id}.p8")
    certs_dir = "#{ENV['RUNNER_TEMP']}/certs"

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # 1) certificado: se guarda en artifact para reutilizarlo en el futuro
    cert = get_certificates(
      api_key: api_key,
      team_id: "D695835P4T",
      platform: "ios",
      output_path: certs_dir
    )
    UI.message("Certificado: #{cert.class}")

    # exportar el certificado con su llave privada para reutilizarlo despues
    begin
      sh("mkdir -p #{certs_dir}")
      sh("security export -k #{Dir.home}/Library/Keychains/login.keychain-db -t identities -f pkcs12 -P '#{ENV['P12_PASSWORD']}' -o #{certs_dir}/distribucion.p12")
      UI.message("Certificado exportado en #{certs_dir}")
    rescue => e
      UI.message("No se pudo exportar el p12: #{e}")
    end

    # 2) perfil de App Store para SORA
    profile_path = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.soradestiny.app",
      team_id: "D695835P4T",
      skip_certificate_verification: false
    ).to_s

    uuid = File.basename(profile_path, ".mobileprovision")
    if uuid.length < 30
      uuid = `security cms -D -i "#{profile_path}" 2>/dev/null | plutil -extract UUID raw - 2>/dev/null`.strip
    end
    UI.message("Perfil instalado: #{profile_path} -> uuid #{uuid}")
    raise "No se pudo obtener el UUID del perfil" if uuid.length < 30

    # 3) compilar con firma manual usando ese perfil
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{ENV['RUNNER_TEMP']}/out",
      buildlog_path: "#{ENV['RUNNER_TEMP']}/logs",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{uuid}' OTHER_CODE_SIGN_FLAGS='--timestamp=none' -disableAutomaticPackageResolution"
    )

    # 4) subir a App Store Connect
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: false,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end
end
