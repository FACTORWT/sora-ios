default_platform(:ios)

platform :ios do
  lane :beta do
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    key_path = File.expand_path("~/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: "com.soradestiny.app",
      team_id: "D695835P4T",
      api_key: api_key,
      git_url: "https://x-access-token:#{ENV['GITHUB_TOKEN']}@github.com/FACTORWT/sora-ios.git",
      git_branch: "certificates",
      storage_mode: "git",
      readonly: false
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{ENV['RUNNER_TEMP']}/out",
      buildlog_path: "#{ENV['RUNNER_TEMP']}/logs"
    )

    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: false,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end
end
