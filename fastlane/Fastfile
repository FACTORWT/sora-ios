default_platform(:ios)

platform :ios do
  lane :beta do
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    key_path = File.expand_path("~/private_keys/AuthKey_#{key_id}.p8")
    certs_dir = "#{ENV['RUNNER_TEMP']}/certs"

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # 1) certificado: se guarda en artifact para reutilizarlo en el futuro
    cert = get_certificates(
      api_key: api_key,
      team_id: "D695835P4T",
      platform: "ios",
      output_path: certs_dir
    )
    UI.message("Certificado: #{cert.class}")

    # 2) perfil de App Store para SORA
    profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.soradestiny.app",
      team_id: "D695835P4T",
      skip_certificate_verification: false
    )
    UI.message("Perfil: #{profile.name} / uuid #{profile.uuid}")

    # 3) compilar con firma manual usando ese perfil
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{ENV['RUNNER_TEMP']}/out",
      buildlog_path: "#{ENV['RUNNER_TEMP']}/logs",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile.uuid}'"
    )

    # 4) subir a App Store Connect
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: false,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end
end
